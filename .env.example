# GitHub token for installing @jayziv scoped packages from GitHub Packages
# Create at: https://github.com/settings/tokens/new?scopes=read:packages
GITHUB_TOKEN=

# Your deployed site URL (used for Open Graph, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL=https://your-site.com

# Email (Resend) — required for contact form
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_TO_EMAIL=you@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# =============================================================================
# CMS Configuration
# =============================================================================

# CMS provider — determines which content adapter to use
# Options: static | keystatic | sanity
CMS_PROVIDER=static

# -----------------------------------------------------------------------------
# Keystatic Configuration (only needed when CMS_PROVIDER=keystatic)
# -----------------------------------------------------------------------------
# No additional env vars needed — Keystatic uses local file storage by default.
# For GitHub mode, see: https://keystatic.com/docs/github-mode

# -----------------------------------------------------------------------------
# Sanity Configuration (only needed when CMS_PROVIDER=sanity)
# -----------------------------------------------------------------------------
# Create a project at https://sanity.io/manage, then set these:
# NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_VERSION=2024-01-01
# SANITY_TOKEN=your-read-token (optional, for private datasets)
